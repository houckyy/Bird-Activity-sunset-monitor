default_platform(:ios)

platform :ios do
  desc "Fetch signing certificate + provisioning profile (read-only, never generates new ones)"
  lane :signing do
    match(
      type: "appstore",
      readonly: true,
      api_key: app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_PRIVATE_KEY"],
        is_key_content_base64: true
      )
    )
  end

  desc "Build the .ipa and upload it to App Store Connect (TestFlight track by default)"
  lane :release do
    signing

    # Build number must increase on every App Store Connect upload. Using
    # the GitHub Actions run number keeps this automatic and monotonic
    # without committing anything back to the repo just to bump a counter.
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Raylight.ipa"
    )

    upload_to_testflight(
      api_key: app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_PRIVATE_KEY"],
        is_key_content_base64: true
      ),
      ipa: "build/Raylight.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
